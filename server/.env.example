# 复制为 server/.env 后填写，切勿提交真实 Key。
#
# 本地开发一行都不用改也能跑（下面的值全部可以留空）。
# **上线是另一回事**：生产环境必须逐项配好，否则服务拒绝启动。
# 生产用的完整样例在 deploy/rental.env.example，步骤见 docs/上线部署手册.md。

# ---------------------------------------------------------------- 地图
AMAP_WEB_SERVICE_KEY=
MAP_GEOCODE_ENABLED=true

# ---------------------------------------------------------------- 上线才需要
# 留空时用的是开发默认值——**那些默认值写在公开仓库里**：
#   拿 AUTH_SECRET 可以自己签一个管理员令牌；
#   拿 PAYMENT_SIGN_SECRET 可以伪造支付回调，把账单改成已付。
# 所以只要对外可访问，这两项就必须设。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
PAYMENT_SIGN_SECRET=

# 数据库。留空用本地 SQLite 文件（开发默认）。
# DATABASE_URL=mysql+pymysql://user:pwd@127.0.0.1:3306/rental?charset=utf8mb4
DATABASE_URL=

# 跨域白名单（逗号分隔）。留空则只放行 localhost。
CORS_ORIGINS=

# 前面有几层反向代理。**决定限流与操作日志怎么取客户端 IP**：
# 0（默认）完全不看 X-Forwarded-For；nginx 一层写 1。
TRUSTED_PROXY_HOPS=0

# 设成 production 会打开上线自检，上面几项不合格就拒绝启动。
APP_ENV=
