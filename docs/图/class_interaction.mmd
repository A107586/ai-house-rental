    class Api["互动与消息 · HTTP 接口（18 个）"] {
        <<router>>
        +list_conversations() GET /api/conversations
        +start_conversation(ConversationStart) POST /api/conversations
        +list_lines() GET /api/conversations/:conversation_id/lines
        +send_line(LineCreate) POST /api/conversations/:conversation_id/lines
        +mark_conversation_read() POST /api/conversations/:conversation_id/read
        +list_favorites() GET /api/favorites
        +remove_favorite() DELETE /api/favorites/:house_no
        +add_favorite() POST /api/favorites/:house_no
        +clear_history() DELETE /api/history
        +browsing_history() GET /api/history
        +list_messages() GET /api/messages
        +read_all_messages() POST /api/messages/read-all
        +read_message() PATCH /api/messages/:message_id/read
        +list_notices() GET /api/notices
        +create_notice(NoticeCreate) POST /api/notices
        +toggle_notice() PATCH /api/notices/:notice_id
        +create_review(ReviewCreate) POST /api/reviews
        +pending_reviews() GET /api/reviews/pending
    }
