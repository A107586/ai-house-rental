classDiagram
    direction LR
    class Api["智能客服与知识 · HTTP 接口（12 个）"] {
        <<router>>
        +clear_chat() DELETE
        +list_chat() GET
        +log_chat(ChatLog) POST
        +list_faqs() GET
        +create_faq(FaqPayload) POST
        +delete_faq() DELETE
        +toggle_faq() PATCH
        +update_faq(FaqPayload) PUT
        +support_feedback(FeedbackPayload) POST
        +create_handoff(HandoffPayload) POST
        +my_handoffs() GET
        +log_support(SupportLogPayload) POST
    }
    class m_shared["借用其他模块的服务"] {
        <<service>>
        +deps.current_user()
        +deps.require_login()
        +leasing.notify()
    }
    Api ..> m_shared
    class ChatMessage["ChatMessage · 对话记录"] {
        <<entity>>
        +int id «PK»
        +int user_id «FK»
        +str role
        +… 另 4 列（见数据库设计书）
    }
    class Faq["Faq · 客服知识条目"] {
        <<entity>>
        +int id «PK»
        +str code «UK»
        +str category
        +bool is_published
        +… 另 6 列（见数据库设计书）
        +to_dict()
    }
    class SupportLog["SupportLog · 客服问答日志"] {
        <<entity>>
        +int id «PK»
        +int user_id «FK»
        +str status
        +… 另 11 列（见数据库设计书）
        +to_dict()
    }
    class SupportHandoff["SupportHandoff · 转人工工单"] {
        <<entity>>
        +int id «PK»
        +str handoff_no «UK»
        +int user_id «FK»
        +str status
        +int handler_id «FK»
        +… 另 6 列（见数据库设计书）
        +to_dict()
    }
    class User["User · 用户（账号与权限）"]
    <<entity>> User
    User "0..1" -- "0..*" ChatMessage : user_id
    User "0..1" -- "0..*" SupportLog : user_id
    User "1" -- "0..*" SupportHandoff : user_id
    User "0..1" -- "0..*" SupportHandoff : handler_id
