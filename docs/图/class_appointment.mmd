classDiagram
    direction LR
    class Api["看房预约 · HTTP 接口（4 个）"] {
        <<router>>
        +list_appointments() GET
        +create_appointment(AppointmentCreate) POST
        +my_appointments() GET
        +update_appointment(AppointmentUpdate) PATCH
    }
    class m_shared["借用其他模块的服务"] {
        <<service>>
        +config_store.get_int()
        +deps.require_login()
        +leasing.notify()
        +permissions.can_manage_house()
        +permissions.responsible_user_id()
        +permissions.can_see_tenant_contact()
    }
    Api ..> m_shared
    class Appointment["Appointment · 看房预约"] {
        <<entity>>
        +int id «PK»
        +int house_id «FK»
        +int tenant_id «FK»
        +datetime viewing_time
        +str status
        +… 另 5 列（见数据库设计书）
        +to_dict(show_contact)
    }
    class House["House · 房源（房源）"]
    <<entity>> House
    class User["User · 用户（账号与权限）"]
    <<entity>> User
    House "1" -- "0..*" Appointment : house_id
    User "0..1" -- "0..*" Appointment : tenant_id
