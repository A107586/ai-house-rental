        <<entity>>
        +int id «PK»
        +int repair_id «FK»
        +… 另 2 列（见数据库设计书）
    }
    class RepairWorker["RepairWorker · 维修人员"] {
        <<entity>>
        +int id «PK»
        +str status
        +… 另 4 列（见数据库设计书）
