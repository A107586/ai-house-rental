classDiagram
    direction LR
    class Api["报修与维修 · HTTP 接口（14 个）"] {
        <<router>>
        +list_items() GET
        +create_item(ItemCreate) POST
        +update_item(ItemUpdate) PATCH
        +list_records() GET
        +repair_stats() GET
        +list_workers() GET
        +create_worker(WorkerCreate) POST
        +update_worker(WorkerUpdate) PATCH
        +list_repairs() GET
        +create_repair(RepairCreate) POST
        +update_repair(RepairUpdate) PATCH
        +list_repair_images() GET
        +add_repair_image() POST
        +create_record(RecordCreate) POST
    }
    class m_shared["借用其他模块的服务"] {
        <<service>>
        +config_store.get_int()
        +deps.current_user()
        +deps.require_login()
        +deps.require_staff()
        +leasing.notify()
        +permissions.can_manage_house()
        +permissions.can_report_repair()
        +uploads.is_managed()
    }
    Api ..> m_shared
    class Repair["Repair · 报修工单"] {
        <<entity>>
        +int id «PK»
        +int house_id «FK»
        +int tenant_id «FK»
        +str category
        +str urgency
        +str status
        +… 另 6 列（见数据库设计书）
        +to_dict(with_contact)
    }
