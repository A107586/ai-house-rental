    class Api["报修与维修 · HTTP 接口（14 个）"] {
        <<router>>
        +list_items() GET /api/repair-items
        +create_item(ItemCreate) POST /api/repair-items
        +update_item(ItemUpdate) PATCH /api/repair-items/:item_id
        +list_records() GET /api/repair-records
        +repair_stats() GET /api/repair-stats
        +list_workers() GET /api/repair-workers
        +create_worker(WorkerCreate) POST /api/repair-workers
        +update_worker(WorkerUpdate) PATCH /api/repair-workers/:worker_id
        +list_repairs() GET /api/repairs
        +create_repair(RepairCreate) POST /api/repairs
        +update_repair(RepairUpdate) PATCH /api/repairs/:repair_id
        +list_repair_images() GET /api/repairs/:repair_id/images
        +add_repair_image() POST /api/repairs/:repair_id/images
        +create_record(RecordCreate) POST /api/repairs/:repair_id/record
    }
