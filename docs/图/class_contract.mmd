    class Api["合同与账单 · HTTP 接口（16 个）"] {
        <<router>>
        +my_bills() GET /api/bills/mine
        +pay_bill(PayRequest) POST /api/bills/:bill_no/pay
        +create_contract(ContractCreate) POST /api/contracts
        +my_contracts() GET /api/contracts/mine
        +get_contract() GET /api/contracts/:contract_no
        +update_contract(ContractUpdate) PATCH /api/contracts/:contract_no
        +activate_contract() POST /api/contracts/:contract_no/activate
        +contract_detail() GET /api/contracts/:contract_no/detail
        +end_contract(ContractEnd) POST /api/contracts/:contract_no/end
        +renew_contract(ContractRenew) POST /api/contracts/:contract_no/renew
        +save_review_result(ReviewResultIn) POST /api/contracts/:contract_no/review-result
        +payment_notify() POST /api/payments/notify
        +payment_receipt() GET /api/payments/:trade_no
        +mock_pay() POST /api/payments/:trade_no/mock-pay
        +payment_status() GET /api/payments/:trade_no/status
        +my_refunds() GET /api/refunds/mine
    }
    class m_gateway["gateway.py"] {
        <<service>>
        +sign(params)
        +verify(params)
        +get_gateway()
        +dumps(params)
    }
    Api ..> m_gateway
    class m_leasing["leasing.py"] {
        <<service>>
        +add_months(moment, months)
        +months_between(start, end)
        +resolve_deposit(house, deposit_months, default_deposit_months)
        +create_contract(session, house, tenant, start_date, months, deposit_months, pay_months, content, default_deposit_months)
        +house_specific_clauses(house, deposit, pay_months)
        +render_contract_text(house, tenant, start_date, end_date, rent, deposit, pay_months)
        +settle_delegation(session, contract, house)
        +activate_contract(session, contract)
        +generate_bills(session, contract)
        +start_payment(session, bill, user, method, idempotency_key)
        +confirm_payment(session, payment, payload, result)
        +close_payment(session, payment, reason)
        +sweep_expired_payments(session, now)
        +pay_bill(session, bill, user, method, idempotency_key)
        +end_contract(session, contract, reason, deduct)
        +renew_contract(session, contract, months)
        +notify(session, user_id, type_, title, content, link_no)
    }
