{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rental-server",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8080",
        "--no-proxy-headers"
      ],
      "cwd": "server",
      "port": 8080
    },
    {
      "name": "rental-agent",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--no-proxy-headers"
      ],
      "cwd": "agent",
      "port": 8000
    },
    {
      "name": "rental-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "web",
      "port": 5173
    }
  ]
}
