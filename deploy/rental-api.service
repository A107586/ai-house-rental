# 业务后端。
#   sudo cp deploy/rental-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rental-api

[Unit]
Description=大连智租 业务后端 (FastAPI)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=rental
Group=rental
WorkingDirectory=/srv/rental/server
EnvironmentFile=/etc/rental/rental.env

# **只监听回环地址。** 对外一律走 nginx：
# 直接暴露 8080 的话，X-Forwarded-For 就成了谁都能写的东西，
# 限流与操作日志里的 IP 会全部失真。
#
# worker 数：N-01 实测 4 个 worker 把房源列表从 1947ms 压到 305ms。
# 按 CPU 核数给，1~2 核的小机器写 2。
# **必须显式写 `--no-proxy-headers`。**
#
# uvicorn 的 proxy_headers **默认就是开的**，并且默认信任 127.0.0.1：
# 只要连接来自本机，它就拿 X-Forwarded-For 改写 request.client.host。
# 这一段原先写的是「刻意不加 --proxy-headers」——**不加等于开着**，
# 那句注释描述的是一个并不存在的状态。
#
# 是 2026-09-28 冒烟测出来的：单元测试全绿（TestClient 不经过 uvicorn
# 的中间件），而对着真服务从本机连错 8 次之后，换一个 X-Forwarded-For
# 又放行了。
#
# 转发头只让一层来管：应用按 TRUSTED_PROXY_HOPS 自己处理（从右边数）。
ExecStart=/srv/rental/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8080 --workers 4 --no-proxy-headers

Restart=always
RestartSec=3
# 启动自检不过时进程会直接退出（这是设计），别让它疯狂重启刷日志
StartLimitBurst=3
StartLimitIntervalSec=60

# 只给它该有的权限
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 上传目录要可写，其余文件系统只读
ReadWritePaths=/srv/rental/server/static /var/log/rental

StandardOutput=append:/var/log/rental/api.log
StandardError=append:/var/log/rental/api.log

[Install]
WantedBy=multi-user.target
