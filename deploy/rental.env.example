# 生产环境变量样例。
#
# 用法：
#   sudo install -d -m 750 /etc/rental
#   sudo cp deploy/rental.env.example /etc/rental/rental.env
#   sudo chmod 640 /etc/rental/rental.env      # 里面有数据库口令与 API Key
#   sudo nano /etc/rental/rental.env           # 逐项填写
#
# 填完先预演，别直接发：
#   python scripts/preflight_prod.py --env-file /etc/rental/rental.env
#
# **这份文件不要提交到仓库。** 仓库里只留这份样例。

# ---------------------------------------------------------------- 环境
# 必须是 production，否则启动自检整套不会执行（配置错了也照样起得来）
APP_ENV=production

# ---------------------------------------------------------------- 密钥
# 两个都必须改。默认值写在公开仓库里：
#   拿 AUTH_SECRET 可以自己签一个管理员令牌，不需要密码；
#   拿 PAYMENT_SIGN_SECRET 可以伪造支付回调，把任意账单改成已付。
#
# 各生成一个（两个不要用同一个值）：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
PAYMENT_SIGN_SECRET=

# 令牌有效期（秒）。默认 7 天；公网上建议短一些，比如 1 天
AUTH_TTL_SECONDS=86400

# ---------------------------------------------------------------- 数据库
# 生产用 MySQL。SQLite 是库级写锁，多 worker 会互相抢锁，
# 而多 worker 正是 N-01 提速的手段。
DATABASE_URL=mysql+pymysql://rental:改成真口令@127.0.0.1:3306/rental?charset=utf8mb4

# ---------------------------------------------------------------- 站点
# 跨域白名单，逗号分隔，填你的站点域名。不设会停在 localhost 上。
CORS_ORIGINS=https://rent.example.com

# 前面有几层反向代理。nginx 一层就写 1。
#
# **这个值决定限流与操作日志怎么取客户端 IP。** 写 0（或不写）时
# 完全不看 X-Forwarded-For；写 1 时从右边数第一段——
# 右边那段是 nginx 亲眼看到的地址，客户端伪造不了。
TRUSTED_PROXY_HOPS=1

# 慢请求日志的判定线（毫秒）
SLOW_REQUEST_MS=500

# ---------------------------------------------------------------- 地图
# 高德 Web 服务 Key（服务端地理编码用）。留空则不做地理编码，
# 房源仍可发布，只是地图上没有点。
AMAP_WEB_SERVICE_KEY=
MAP_GEOCODE_ENABLED=true

# ---------------------------------------------------------------- 智能体
# 智能体服务读的是同一份文件（systemd 里两个单元都指向它）。
BACKEND_BASE_URL=http://127.0.0.1:8080
BACKEND_TIMEOUT=10

# 大模型。**留空则整套以纯规则模式运行**，找房、预约、报修照常可用，
# 只是精度低一截（需求 N-07 的降级档）。
# 想省钱或先只跑通链路时，可以先留空。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1024

# 融合开关。关掉则不调用大模型（应急止血用：比如发现账单被刷）
FUSION_ENABLED=true

AGENT_PORT=8000
