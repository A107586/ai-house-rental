# 复制本文件为 .env 后填写。.env 已在 .gitignore 中排除，切勿提交。

# ---------- 业务后端 ----------
# 注意必须带 context-path，缺少它会 404
BACKEND_BASE_URL=http://localhost:8080/springboot93c4v
BACKEND_TIMEOUT=10

# ---------- 大模型 ----------
# 全部留空则服务以纯规则模式运行，找房功能依然可用（降级模式）。
# 国内主流厂商都提供 OpenAI 兼容端点，换厂商通常只改下面三行。
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=30
# 单次请求上下文上限，控制 Token 消耗
LLM_MAX_TOKENS=1024

# ---------- 路由阈值 ----------
# 规则解析置信度低于此值才调用大模型兜底
RULE_CONFIDENCE_THRESHOLD=0.5

AGENT_PORT=8000
