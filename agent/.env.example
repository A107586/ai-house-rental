# 复制本文件为 .env 后填写。.env 已在 .gitignore 中排除，切勿提交。

# ---------- 业务后端 ----------
BACKEND_BASE_URL=http://localhost:8080
BACKEND_TIMEOUT=10

# ---------- 大模型 ----------
# 全部留空则服务以纯规则模式运行，找房与预约功能依然可用（降级模式）。
# 团队选定 DeepSeek。它兼容 OpenAI Chat Completions 协议，
# 换成通义千问 / 智谱 GLM / Kimi 只需改 LLM_BASE_URL 和 LLM_MODEL 两行。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
# 单次请求上下文上限，控制 Token 消耗
LLM_MAX_TOKENS=1024

# ---------- 向量嵌入（AI-03 智能客服的可选通道）----------
# **与 LLM_* 是独立的一组配置，不能复用。** 团队的大模型是 DeepSeek，
# 而 DeepSeek 不提供 embeddings 接口，嵌入要走别的服务。
#
# 本地部署（LM Studio / Ollama / vLLM）都实现了 OpenAI 兼容的 /v1/embeddings，
# 填地址与模型名即可；留空则只用词法检索，功能完整、全部测试也跑在这个模式下。
#
# LM Studio 默认：EMBED_BASE_URL=http://127.0.0.1:1234/v1
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_TIMEOUT=30
# 语料向量的落盘缓存。按内容哈希做键，改了语料或换了模型会自动失效
EMBED_CACHE_PATH=

# ---------- 路由阈值 ----------
# 规则解析置信度低于此值才调用大模型兜底
RULE_CONFIDENCE_THRESHOLD=0.5

AGENT_PORT=8000

# 规则与大模型是否同时参与（默认 true）。
# 开启时每次请求都会调一次大模型，由它在规则结论的基础上给出最终结果。
# 置为 false 则走纯规则，功能完整但少了大模型的修正——演示、压测或需要
# 控制 Token 消耗（需求 N-08）时可以关掉。
FUSION_ENABLED=true
